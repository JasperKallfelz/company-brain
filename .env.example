# Production application environment. Copy to an untracked, restricted secret file.
# Replace every placeholder. This file is NOT used by the local demo.
DATABASE_URL=postgresql://brain_reader:REPLACE_WITH_RANDOM_READER_PASSWORD@db:5432/company_brain
BRAIN_PROFILE=production
BRAIN_BASE_URL=https://brain.example.com
BRAIN_OAUTH_ISSUER=https://auth.example.com/realms/company-brain
